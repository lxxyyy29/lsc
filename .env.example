# 数据库配置
DB_URL=jdbc:mysql://127.0.0.1:3306/zhsq?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_db_password_here

# Redis 配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# JWT 安全密钥（生产环境必须修改！）
JWT_SECRET=change_this_to_a_random_64_char_string

# 无人机平台
DRONE_API_PASSWORD=your_drone_password
DRONE_API_SM4_SECRET_KEY=your_sm4_key
DRONE_API_SM4_IV=your_sm4_iv

# OSS 存储
OSS_SECRET_KEY=your_oss_secret

# 告警回调验证（生产环境必须配置）
DRONE_ALARM_CALLBACK_TOKEN=your_callback_verification_token
DRONE_ALARM_CALLBACK_SIGNATURE_SECRET=your_signature_secret
