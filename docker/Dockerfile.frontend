# ============================================
# 前端 Dockerfile - Nginx 静态服务
# ============================================
FROM nginx:alpine AS base

# 删除默认配置
RUN rm /etc/nginx/conf.d/default.conf

# ============================================
# Web 管理端
# ============================================
FROM node:20-alpine AS web-builder
WORKDIR /app
COPY web/package.json web/pnpm-lock.yaml ./
RUN npm install -g pnpm && pnpm install --frozen-lockfile --offline 2>/dev/null || pnpm install
COPY web/ .
RUN pnpm build

FROM base AS web
COPY --from=web-builder /app/dist /usr/share/nginx/html
COPY docker/nginx-web.conf /etc/nginx/conf.d/default.conf

# ============================================
# H5 移动端
# ============================================
FROM node:20-alpine AS h5-builder
WORKDIR /app
COPY h5/package.json h5/pnpm-lock.yaml ./
RUN npm install -g pnpm && pnpm install --frozen-lockfile --offline 2>/dev/null || pnpm install
COPY h5/ .
RUN pnpm build -p h5

FROM base AS h5
COPY --from=h5-builder /app/dist/build/h5 /usr/share/nginx/html
COPY docker/nginx-h5.conf /etc/nginx/conf.d/default.conf

# ============================================
# 小程序
# ============================================
FROM node:20-alpine AS mp-builder
WORKDIR /app
COPY mp/package.json mp/pnpm-lock.yaml ./
RUN npm install -g pnpm && pnpm install --frozen-lockfile --offline 2>/dev/null || pnpm install
COPY mp/ .
RUN pnpm build

FROM base AS mp
COPY --from=mp-builder /app/dist /usr/share/nginx/html
COPY docker/nginx-mp.conf /etc/nginx/conf.d/default.conf

# 默认导出 web
FROM web
EXPOSE 80
