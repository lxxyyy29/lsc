# ============================================
# 后端 Dockerfile - Spring Boot 应用
# ============================================
FROM eclipse-temurin:17-jdk-alpine AS builder

WORKDIR /app

# 复制 Maven 配置和源码
COPY pom.xml .
COPY src ./src

# 打包（跳过测试加速构建；配置阿里云 Maven 镜像源，避免官方源网络不稳定导致依赖解析失败）
RUN apk add --no-cache maven && \
    mkdir -p /root/.m2 && \
    printf '%s\n' \
      '<settings>' \
      '  <mirrors>' \
      '    <mirror>' \
      '      <id>aliyun</id>' \
      '      <name>Aliyun Maven Mirror</name>' \
      '      <url>https://maven.aliyun.com/repository/public</url>' \
      '      <mirrorOf>*</mirrorOf>' \
      '    </mirror>' \
      '  </mirrors>' \
      '</settings>' > /root/.m2/settings.xml && \
    mvn clean package -DskipTests -q

# ============================================
# 运行阶段
# ============================================
FROM eclipse-temurin:17-jre-alpine

WORKDIR /app

# 安装 curl 用于健康检查
RUN apk add --no-cache curl tzdata && \
    cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo "Asia/Shanghai" > /etc/timezone

# 从构建阶段复制 JAR
COPY --from=builder /app/target/*.jar app.jar

# 创建上传目录
RUN mkdir -p /app/uploads

# 健康检查：探测服务 HTTP 连通性（任何 HTTP 响应均视为存活，连接失败才判不健康）
# 注：不用 curl -f，因为登录失败会返回非 2xx，用虚构账号登录成功与否做健康判据会误报
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -s -o /dev/null -X POST -H "Content-Type: application/json" -d '{"account":"health","password":"check","clientType":"WEB"}' http://localhost:8080/api/auth/login || exit 1

# 暴露端口
EXPOSE 8080

# 启动命令
ENTRYPOINT ["java", "-Xms512m", "-Xmx1g", "-XX:+UseG1GC", "-jar", "app.jar"]
