# ============================================
# 东莞杰瑞智慧网格治理平台 - 环境变量配置
# ⚠️ 生产环境必须修改所有默认密码！
# ============================================

# ==========================================
# Compose 项目名（⚠️ 建议显式指定，避免与服务器上其他项目撞名）
# 不指定时 Compose 会取「compose 文件所在目录的目录名」，本文件在 <仓库>/docker/ 下，
# 项目名就会是极通用的 "docker"。若服务器上别的项目也有 docker/ 目录跑 compose，
# 两者项目名相同，届时在本目录执行 docker compose down 可能连带删掉别人的容器。
# 明确写成 changping 即可彻底避免（容器名本来就是 changping- 前缀，不受影响）
# ==========================================
COMPOSE_PROJECT_NAME=dgjr

# ==========================================
# 部署根目录（宿主机绝对路径）
# 代码放在 /uav_data/dgjr（仓库根即该目录，compose 在 /uav_data/dgjr/docker），
# 数据库/上传文件等持久化数据放在它下面，与服务器上其他项目隔离。
# ⚠️ 不要指向已有其他项目数据的目录
# 注：这些数据目录已被根 .dockerignore 排除，不会被打进 docker 构建上下文
# ==========================================
DATA_ROOT=/uav_data/dgjr

# 固定摄像头 HLS 转流目录（宿主机 ffmpeg 输出目录；不用摄像头保持默认即可）
VIDEO_HLS_DIR=/uav_data/dgjr/video-hls

# ==========================================
# 端口配置（避开已有服务端口）
# ==========================================
WEB_PORT=9071
BACKEND_PORT=9072
H5_PORT=9073
MP_PORT=9074
# Web 管理端 HTTPS 端口（不用 HTTPS 可注释掉，并删除 compose 里 443 的映射）
HTTPS_PORT=9075

# ==========================================
# MySQL ⚠️ 必须修改
# ==========================================
MYSQL_ROOT_PASSWORD=Changping@2024!Secure

# ==========================================
# Redis ⚠️ 必须修改
# ==========================================
REDIS_PASSWORD=Changping@2024!Redis

# ==========================================
# MinIO ⚠️ 必须修改
# ==========================================
MINIO_USER=admin
MINIO_PASSWORD=Changping@2024!Minio

# ==========================================
# JWT 密钥 ⚠️ 必须修改为随机长字符串
# ==========================================
JWT_SECRET=please-change-this-to-a-random-string-min-32-chars-long

# ==========================================
# 域名/访问地址
# ==========================================
DOMAIN=http://8.138.97.118:9071

# ==========================================
# OSS / 媒体文件公网访问前缀
# 通过 web 容器的 /minio/ 反代访问本项目 MinIO，改服务器时同步改这里
# ==========================================
OSS_ACCESS=http://8.138.97.118:9071/minio/

# ==========================================
# 阿里云短信（手机号验证码，选配）
# 不配置时，只要下面的 SMS_TEST_CODE 非空，验证码登录仍可正常联调
# ==========================================
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# ==========================================
# 联调固定验证码
# true + 非空验证码 → 该验证码可直接登录任意已绑定手机号的账号
#                    （「获取验证码」也不真发短信，无需阿里云短信配置）
# ⚠️ 正式环境请改为 false 关闭，否则等于给所有手机号账号开放后门
# 注意：请用 false 关闭，不要用「SMS_TEST_CODE=」置空的方式
#       —— compose 的 ${VAR:-默认值} 会把空值回退成默认值 123456，反而关不掉
# ==========================================
SMS_TEST_CODE_ENABLED=true
SMS_TEST_CODE=123456
